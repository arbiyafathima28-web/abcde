# Backend Environment Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# JSON string or path for service account. On Cloud Run, prefer Secret Manager or Cloud IAM ADC.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini API Key for Security Incident Explanations
GEMINI_API_KEY=

# Port for Cloud Run / Uvicorn
PORT=8080

# CORS Allowed Origins (comma separated list, e.g. https://my-frontend.web.app,http://localhost:3000)
# Leave empty to allow dev & preview domains
CORS_ORIGINS=
